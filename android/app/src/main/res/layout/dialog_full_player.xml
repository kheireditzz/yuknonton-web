<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neu_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Top Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <ImageButton
            android:id="@+id/btnClosePlayer"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/neu_button_circle"
            android:contentDescription="Tutup Player"
            android:padding="10dp"
            android:src="@drawable/ic_close" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="SEDANG DIPUTAR"
            android:textColor="@color/primary_teal"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnDownloadFromPlayer"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/neu_button_circle"
            android:contentDescription="Unduh Lagu"
            android:padding="10dp"
            android:src="@drawable/ic_download" />
    </RelativeLayout>

    <!-- Scrollable container for Artwork, Info, Lyrics -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- Neumorphic Album Art Frame -->
            <androidx.cardview.widget.CardView
                android:layout_width="240dp"
                android:layout_height="240dp"
                android:layout_marginVertical="16dp"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/neu_bg">

                <ImageView
                    android:id="@+id/imgPlayerArtwork"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_music_note"
                    android:contentDescription="Album Art" />
            </androidx.cardview.widget.CardView>

            <!-- Song Title & Artist -->
            <TextView
                android:id="@+id/tvPlayerTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:ellipsize="marquee"
                android:gravity="center"
                android:marqueeRepeatLimit="marquee_forever"
                android:singleLine="true"
                android:text="Judul Lagu"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPlayerArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="marquee"
                android:gravity="center"
                android:singleLine="true"
                android:text="Nama Artis"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />

            <!-- Lyrics Card -->
            <LinearLayout
                android:id="@+id/layoutLyricsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/neu_card_extruded"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_lyrics"
                        android:contentDescription="Icon Lirik" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Lirik Karaoke Real-Time"
                        android:textColor="@color/primary_teal"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvPlayerLyrics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="4dp"
                    android:maxLines="6"
                    android:text="Memuat lirik lagu..."
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- SeekBar Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <SeekBar
            android:id="@+id/playerSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:progressTint="@color/primary_teal"
            android:thumbTint="@color/primary_teal"
            android:paddingHorizontal="0dp" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/tvCurrentTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:text="00:00"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvTotalDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="00:00"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </RelativeLayout>
    </LinearLayout>

    <!-- Player Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="14dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnShuffle"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/neu_button_circle"
            android:contentDescription="Acak"
            android:padding="12dp"
            android:src="@drawable/ic_shuffle" />

        <ImageButton
            android:id="@+id/btnPrevious"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/neu_button_circle"
            android:contentDescription="Sebelumnya"
            android:padding="14dp"
            android:src="@drawable/ic_skip_previous" />

        <ImageButton
            android:id="@+id/btnPlayPauseLarge"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:background="@drawable/neu_button_circle"
            android:contentDescription="Putar atau Jeda"
            android:padding="16dp"
            android:src="@drawable/ic_play_arrow" />

        <ImageButton
            android:id="@+id/btnNext"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/neu_button_circle"
            android:contentDescription="Berikutnya"
            android:padding="14dp"
            android:src="@drawable/ic_skip_next" />

        <ImageButton
            android:id="@+id/btnRepeat"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/neu_button_circle"
            android:contentDescription="Ulangi"
            android:padding="12dp"
            android:src="@drawable/ic_repeat" />
    </LinearLayout>

</LinearLayout>
