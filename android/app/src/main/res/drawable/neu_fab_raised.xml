<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed State: Inset sunken -->
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/primary_dark" />
            <stroke android:width="2dp" android:color="@color/primary_teal" />
        </shape>
    </item>
    <!-- Default Raised State: Extruded -->
    <item>
        <layer-list>
            <item
                android:left="2dp"
                android:top="3dp"
                android:right="0dp"
                android:bottom="0dp">
                <shape android:shape="oval">
                    <solid android:color="@color/neu_dark_shadow" />
                </shape>
            </item>
            <item
                android:left="0dp"
                android:top="0dp"
                android:right="2dp"
                android:bottom="3dp">
                <shape android:shape="oval">
                    <gradient
                        android:angle="135"
                        android:startColor="#007A7A"
                        android:endColor="@color/primary_teal"
                        android:type="linear" />
                    <stroke android:width="1.5dp" android:color="#33FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
