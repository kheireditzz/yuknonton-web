<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#DDD8D3" />
            <stroke android:width="1.5dp" android:color="@color/neu_dark_shadow" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item android:top="2dp" android:left="2dp">
                <shape android:shape="oval">
                    <solid android:color="@color/neu_dark_shadow" />
                </shape>
            </item>
            <item android:bottom="2dp" android:right="2dp">
                <shape android:shape="oval">
                    <solid android:color="@color/neu_bg" />
                    <stroke android:width="1dp" android:color="@color/neu_light_shadow" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
