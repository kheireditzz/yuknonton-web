<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bottom-right dark drop shadow -->
    <item
        android:left="2dp"
        android:top="3dp"
        android:right="0dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <solid android:color="@color/neu_dark_shadow" />
        </shape>
    </item>
    <!-- Main surface with top-left highlight border -->
    <item
        android:left="0dp"
        android:top="0dp"
        android:right="2dp"
        android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <solid android:color="@color/neu_bg" />
            <stroke android:width="1.5dp" android:color="@color/neu_light_shadow" />
        </shape>
    </item>
</layer-list>
