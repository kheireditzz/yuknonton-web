<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer sunken shadow simulation -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#DCD7D1" />
            <stroke android:width="1dp" android:color="@color/neu_dark_shadow" />
        </shape>
    </item>
    <!-- Inner surface -->
    <item android:top="2dp" android:left="2dp" android:bottom="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="13dp" />
            <solid android:color="#E2DFDC" />
        </shape>
    </item>
</layer-list>
